# Copie este arquivo para .env e preencha os valores

# Chave da API do Google Gemini (opcional: reserva caso o Claude Code falhe)
API_KEY=sua_chave_aqui

# Chave da Claude API (só se ela estiver na linha de IAs; sem ela o SDK tenta o `ant auth login`)
# ANTHROPIC_API_KEY=sua_chave_aqui

# Preferências (o menu do start.sh grava aqui; use ./start.sh --config para mudar)
# BOT_IAS=claude_cli,gemini          (ordem da linha: claude_cli, claude_api, gemini)
# BOT_CLI_MODELO=opus                BOT_CLI_EFFORT=medium
# BOT_API_MODELO=claude-sonnet-5-5   BOT_API_EFFORT=medium
# BOT_GEMINI_MODELO=gemini-3.5-flash
# BOT_PLATAFORMAS=moodle,instagram
# BOT_MOODLE_MODO=api                (api: chave MOODLE_TOKEN, sem extensão; extensao: porta 5000)
# BOT_VIGIA=1                        (reinicia o bot se cair ou travar)

# Moodle pela API (BOT_MOODLE_MODO=api): a chave do app Moodle, veja "Moodle pela API" no README.
# Pode colar o moodlemobile://token=... inteiro. Trate como a senha.
# MOODLE_URL=https://moodle.unifei.edu.br
# MOODLE_TOKEN=

# Caminho do banco DuckDB (opcional, padrão: moodle_history.duckdb)
# DB_FILE=moodle_history.duckdb

# Porta do servidor Flask (opcional, padrão: 5000)
# PORT=5000

# Instagram (opcional): o bot escuta a DM com IG_THREAD e responde pela sua conta,
# com os mesmos comandos do Moodle. Precisa de IG_USERNAME, IG_THREAD e IG_PASSWORD ou IG_SESSIONID.
# IG_USERNAME=sua_conta
# IG_PASSWORD=sua_senha
# IG_SESSIONID=cookie_sessionid_do_navegador   (usado no lugar da senha; ver README)
# IG_TOTP_SEED=chave_do_app_autenticador   (só com 2FA por app: o bot gera o código sozinho)
# IG_THREAD=usuario_da_dm   (pode ser a própria conta)
