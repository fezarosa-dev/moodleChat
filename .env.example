# Referência das variáveis do .env (na raiz do projeto).
# Não precisa copiar este arquivo: na primeira vez, o ./start.sh (ou start.bat) abre o menu,
# pergunta tudo e cria o .env sozinho. Depois, ./start.sh --config muda as escolhas.
# O .env guarda chaves e senhas: ele nunca vai para o git (.gitignore). Não o envie para ninguém.

# ── IAs ──────────────────────────────────────────────────────────────────────
# Gemini: chave em https://aistudio.google.com/apikey
# API_KEY=
# Claude API (paga por uso): chave no Console da Anthropic
# ANTHROPIC_API_KEY=
# O Claude Code (CLI) não usa chave: rode `claude` uma vez no terminal para logar.

# ── Moodle pela API (sem extensão) ───────────────────────────────────────────
# A chave do app Moodle (veja "Pegar a chave" no README). Pode colar o moodlemobile://token=... inteiro.
# MOODLE_URL=https://moodle.unifei.edu.br
# MOODLE_TOKEN=

# ── Instagram (opcional) ─────────────────────────────────────────────────────
# Recomendado: uma conta nova só para o bot (risco de bloqueio), com 2FA por app autenticador
# e os códigos de backup anotados num gerenciador de senhas (nunca aqui). Veja o README.
# IG_USERNAME=conta_do_bot
# IG_THREAD=sua_conta_pessoal           (a DM em que o bot escuta e responde)
# IG_PASSWORD=senha_da_conta_do_bot
# IG_TOTP_SEED=chave_do_app_autenticador (com 2FA por app: o bot gera o código sozinho)
# IG_SESSIONID=cookie_sessionid           (o cookie do navegador, no lugar da senha ou como reserva)

# ── Escolhas do menu (o menu grava; prefira ./start.sh --config) ─────────────
# BOT_IAS=claude_cli,gemini           ordem da linha de IAs: claude_cli, claude_api, gemini
# BOT_CLI_MODELO=opus                 BOT_CLI_EFFORT=medium
# BOT_API_MODELO=claude-sonnet-5-5    BOT_API_EFFORT=medium
# BOT_GEMINI_MODELO=gemini-3.5-flash
# BOT_PLATAFORMAS=moodle,instagram
# BOT_MOODLE_MODOS=api,extensao       api e/ou extensao, na ordem: o 1º que funcionar; o outro é reserva
# BOT_IG_LOGIN=senha,sessionid        senha e/ou sessionid, na ordem, idem
# BOT_VIGIA=1                         reinicia o bot se cair ou travar
# BOT_CONFIGURADO=1                   o menu já foi concluído (sem isso, ele abre sozinho)

# ── Avançado ─────────────────────────────────────────────────────────────────
# DB_FILE=dados/moodle_history.duckdb  onde fica o histórico
# PORT=5000                            porta do modo extensão (a extensão espera 5000)
